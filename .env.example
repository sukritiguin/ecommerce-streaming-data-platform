# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---- Airflow ----
AIRFLOW_UID=50000
# Optional: generate with `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
AIRFLOW__CORE__FERNET_KEY=

# ---- MinIO (local S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_RAW_BUCKET=raw-events

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_CLICKSTREAM=clickstream

# ---- Snowflake (fill in once the trial account exists — see README Step 2) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=ECOMMERCE
SNOWFLAKE_SCHEMA=RAW

# ---- dbt MCP (self-hosted, points at the local dbt-core project) ----
DBT_PROJECT_DIR=./dbt
DBT_PATH=dbt

# ---- GitHub MCP (remote server, PAT passed as a bearer header) ----
# Quick option: export GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token)
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---- Notion MCP ----
# No token needed here — the remote server authenticates via OAuth on first use.
